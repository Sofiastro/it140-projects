BEGIN MOVE LOGIC

WHILE game is not over
    DISPLAY current room
    DISPLAY inventory

    PROMPT user: "Enter your move (go North, go South, go East, go West):"
    READ user_input

    IF user_input is one of the valid directions THEN
        IF movement in that direction is allowed from current room THEN
            UPDATE current room to the connected room
            DISPLAY "You are now in [new room name]"
        ELSE
            DISPLAY "You can't go that way!"
        END IF
    ELSE
        DISPLAY "Invalid input!"
    END IF

END WHILE

END MOVE LOGIC

